{
  "rules": {
    "users": {
      "$uid": {
        ".read":  "auth !== null && auth.uid === $uid",
        ".write": "auth !== null && auth.uid === $uid"
      }
    },
    "rooms": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "newData.val() == null || newData.hasChildren()"
      }
    }
  }
}
